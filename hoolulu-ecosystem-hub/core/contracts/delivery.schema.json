{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hoolulu://contracts/delivery",
  "title": "Delivery",
  "type": "object",
  "required": [
    "slug",
    "channel",
    "status"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,38}$"
    },
    "channel": {
      "type": "string",
      "enum": [
        "local-static",
        "zip",
        "tailscale",
        "manual"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "checksum": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "staged",
        "live",
        "maintenance",
        "rolled-back",
        "failed"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "development",
        "production"
      ]
    },
    "delivered_at": {
      "type": "string"
    },
    "deployed_at": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
