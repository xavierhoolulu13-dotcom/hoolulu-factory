# ---------------------------------------------------------------------------
# Hoolulu Ecosystem Hub — every variable the runtime understands.
# Copy to .env (gitignored) or export in your shell. Defaults are sane:
# with no .env at all the hub runs offline-deterministic and never crashes
# because a model server is missing.
# ---------------------------------------------------------------------------

# --- paths -----------------------------------------------------------------
# HOOLULU_ROOT      repo root; hub, builds and deployments resolve from here
# HOOLULU_HUB       hub directory (default: <root>/hoolulu-ecosystem-hub)
# HOOLULU_SWARM     workforce definition (default: <root>/agents/factory.yaml)
# HOOLULU_ROOT=/home/user/hoolulu-factory
# HOOLULU_HUB=/home/user/hoolulu-factory/hoolulu-ecosystem-hub
# HOOLULU_SWARM=/home/user/hoolulu-factory/agents/factory.yaml

# --- offline brain (llama.cpp) ---------------------------------------------
# OpenAI-compatible base URL exposed by llama-server. The hub probes it once
# per command; if it is unreachable the hub falls back to deterministic
# reasoning and says so in `provenance.source`.
HOOLULU_OFFLINE_URL=http://localhost:8080/v1
HOOLULU_OFFLINE_MODEL=local
HOOLULU_OFFLINE_TIMEOUT=20
# Where llama-server looks for .gguf files (Termux default shown).
# HOOLULU_MODELS_DIR=/data/data/com.termux/files/home/models

# --- Amanda (the operator interface) ---------------------------------------
HOOLULU_PORT=8010
HOOLULU_HOST=0.0.0.0
# Used to build the public URLs shown after a deployment. In the sandbox
# preview this is the https://<port>-<sandbox>.e2b.app origin.
# HOOLULU_PUBLIC_URL=http://localhost:8010

# --- guardrails ------------------------------------------------------------
# development = auto-release after QA. production = human gate + evidence.
HOOLULU_TIER=development
# Operator identity stamped on approvals and evidence.
HOOLULU_OPERATOR=operator

# --- skills (markus-compatible) --------------------------------------------
# HOOLULU_SKILLS_DIR=~/.markus/skills

# --- optional network adapters (all off by default) ------------------------
# Nothing here is required. Each one is opt-in and the hub runs without them.
# SEARXNG_URL=http://localhost:8081
# FIRECRAWL_URL=http://localhost:3002
# FIRECRAWL_API_KEY=
# CHANGEDETECTION_URL=http://localhost:5000
# OPENHANDS_URL=http://localhost:3000
