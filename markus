#!/usr/bin/env python3
"""markus — the skill pack CLI.

A thin shim so the commands you already type work in this repo:

    ./markus skill list
    ./markus skill import ~/Downloads/clawhub-skill.zip --force
    ./markus skill export pdf-tools --format claude

It forwards to ``python -m hub.skills.cli`` using the repo's virtualenv when
there is one, so nothing needs to be installed globally.
"""

import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
VENV = ROOT / ".venv" / "bin" / "python"


def main() -> int:
    python = str(VENV) if VENV.exists() else sys.executable
    env = {**os.environ, "HOOLULU_ROOT": str(ROOT), "PYTHONPATH": str(ROOT)}
    # Run in the caller's directory, not the repo root: `markus skill export x
    # --format claude` writes ./x-claude/ where you are standing.
    done = subprocess.run([python, "-m", "hub.skills.cli", *sys.argv[1:]], env=env)
    return done.returncode


if __name__ == "__main__":
    raise SystemExit(main())
